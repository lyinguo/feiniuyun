APP_NAME=NovelScriptAI
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Required for real model calls.
# DashScope OpenAI-compatible example:
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_API_KEY=replace-with-your-real-api-key

LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

MAX_INPUT_CHARS=600000
MAX_CHAPTERS_PER_REQUEST=120
DEFAULT_SHORT_TERM_WINDOW=2
MEMORY_DIR=data/memory

# Optional MCP metadata integration.
ENABLE_MCP_TOOLS=false
MCP_CONFIG_PATH=
